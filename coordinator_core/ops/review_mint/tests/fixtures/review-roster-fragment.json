{
  "schema": "review-roster-fragment",
  "schema_version": 4,
  "blocking_verdicts": {
    "coordinator:prior-art-checker": "BLOCKED-SURFACE-TO-PM",
    "coordinator:code-reviewer": "BLOCKED",
    "coordinator:review-integrator": "BLOCKED",
    "coordinator:docs-checker": null,
    "coordinator:apm": null,
    "coordinator:staff-eng": "REJECTED",
    "coordinator:eng-director": "REJECTED",
    "coordinator:staff-data-sci": "REJECTED",
    "coordinator:senior-front-end": "REJECTED",
    "coordinator:staff-ux": "REJECTED"
  },
  "tiers": {
    "lightweight": {
      "stages": [
        { "agents": ["coordinator:code-reviewer"], "accepts_signals": "named" },
        { "agents": ["coordinator:review-integrator"] }
      ]
    },
    "standard": {
      "stages": [
        { "gate": true, "agents": ["coordinator:prior-art-checker"], "accepts_signals": "preflight" },
        { "agents": ["coordinator:code-reviewer", "coordinator:staff-eng"], "accepts_signals": "named" },
        { "agents": ["coordinator:review-integrator"] },
        { "agents": ["coordinator:apm"] }
      ]
    },
    "full": {
      "stages": [
        { "gate": true, "agents": ["coordinator:prior-art-checker"], "accepts_signals": "preflight" },
        { "agents": ["coordinator:code-reviewer", "coordinator:staff-eng"], "accepts_signals": "named" },
        { "agents": ["coordinator:review-integrator"] },
        { "agents": ["coordinator:eng-director"] },
        { "agents": ["coordinator:apm"] }
      ]
    }
  }
}
