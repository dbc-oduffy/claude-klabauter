{
  "format_version": "docgen-template/v1",
  "doc_type": "handoff",
  "frontmatter": {
    "style": "fenced",
    "fields": [
      {"kind": "value", "key": "title", "field": "title", "quote": true},
      {"kind": "value", "key": "created", "field": "created", "quote": false},
      {"kind": "value", "key": "branch", "field": "branch", "quote": true},
      {"kind": "literal", "line": "status: open"},
      {"kind": "literal", "line": "predecessor: none"},
      {"kind": "literal", "line": "kind: session-handoff"},
      {"kind": "literal", "line": "handoff_phase: continuation"},
      {"kind": "literal", "line": "baton_role: work"},
      {"kind": "literal", "line": "deployment_state: ready_to_fire"},
      {"kind": "literal", "line": "category: infra"},
      {"kind": "value", "key": "summary", "field": "placeholder_summary", "quote": true},
      {"kind": "literal", "line": "pickup_ready: true"},
      {"kind": "present_as_null", "key": "deliverable_id", "field": "deliverable_id", "quote": true},
      {"kind": "present_as_null", "key": "initiative", "field": "initiative", "quote": true, "suffix": "  # FK to state/initiatives/<id>.yaml; null when no named initiative"},
      {"kind": "optional_omit", "key": "handoff_id", "field": "handoff_id", "quote": true},
      {"kind": "optional_omit", "key": "authoring_session", "field": "authoring_session", "quote": true}
    ]
  },
  "body": [
    {"kind": "raw", "lines": [
      "",
      "## What Was Accomplished",
      "",
      "<!-- Replace with what was built, fixed, or shipped this session. -->",
      "",
      "## Current State",
      "",
      "<!-- Replace with where things stand now. -->",
      "",
      "## Next Steps",
      "",
      "<!-- Replace with what the next session should do first. -->",
      "",
      "## What I Learned",
      "",
      "<!-- What did you learn that you'd resent re-deriving? -->",
      "",
      "## Session Ledger",
      "",
      "<!-- Phase 2 LoE accumulator. Each session appends one line per closing ceremony. -->",
      "<!-- Format: YYYY-MM-DD | <sid6> | <tshirt> | <Nd / No> | <one-line summary> -->",
      "<!-- N is an integer COUNT of dispatches, NOT a duration: Nd = agent dispatches, -->",
      "<!-- No = opus dispatches. e.g. `3d / 1o`. A row written as days (`0.3d`) does not -->",
      "<!-- parse, and a chain whose rows do not parse silently renders as ZERO effort. -->",
      ""
    ]}
  ]
}
