  "canonicalisation": {
    "digest_input": "UTF-8 bytes of the canonical JSON of the record: every UnknownRevision field (all nine) and nothing else. revision_digest is not a record field and is never part of the input; previous_revision_digest IS a field and is included.",
    "key_order": "object keys sorted ascending by Unicode code point at every level (Python json.dumps sort_keys=True).",
    "separators": "',' between members and ':' between key and value; no whitespace anywhere, no trailing newline.",
    "unicode": "raw UTF-8: non-ASCII characters are emitted as themselves, never as backslash-u escapes (ensure_ascii=false). No Unicode normalisation of any kind (no NFC/NFD/NFKC): strings are hashed exactly as emitted. Only the JSON-mandatory escapes (quote, backslash, control characters below U+0020) are applied.",
    "observed_at": "hashed as the emitted string, not normalised: 'Z' and '+00:00' spellings of one instant are different records with different digests; the emitter's string is canonical.",
    "null": "previous_revision_digest is the JSON literal null on revision 1 and is included in the digest input.",
    "digest_format": "'sha256:' followed by 64 lowercase hex characters of SHA-256 over the digest input.",
    "chain": "revision 1 has previous_revision_digest null; revision N>1 carries the revision_digest of revision N-1, same unknown_id, revision contiguous from 1.",
    "refusal_rule": "a writer must refuse an import whose bytes differ from the canonical re-serialisation of the record they parse to (the digest input above), even when the record is otherwise valid."
  },
