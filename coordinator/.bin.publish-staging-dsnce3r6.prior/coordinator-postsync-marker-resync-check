"""
coordinator-postsync-marker-resync-check — post-merge / post-checkout gate
for the ~/.claude meta-repo: self-heal this machine's hook-generation
kill-switch state right after a git sync event.

Why this leg exists: every OTHER guard in the 2026-07-28 incident cluster
fires either on the SENDING side (pre-commit: `coordinator-precommit-
foreign-platform-check`, `coordinator-precommit-settings-tracking-check`) or
the AUTHORING side (`gen_settings_hooks.py`'s own kill-switch check, the
`test_gen_settings_hooks.py` portability suite). The incident's actual
TRANSMISSION was a `git merge`/`git pull` on the RECEIVING machine — the one
moment in the observed causal chain (untrack -> propagate on pull ->
generation silently re-enables) that had NO guard at all. This is that leg.
`coordinator-precommit-foreign-platform-check`'s own docstring names this gap
explicitly ("A `post-merge` leg would be needed to close that specific
vector; not built here") — this script is that leg, built.

Three things happen here, in order, every time `.git/hooks/post-merge` or
`.git/hooks/post-checkout` fires inside the meta-repo:

  1. RE-CREATE a missing positive consent marker
     (`.coordinator-hooks-enabled`, see `coordinator_core.install.
     gen_settings_hooks`) from its GITIGNORED PER-MACHINE SOURCE — this
     machine's own `settings.json` `env.COORDINATOR_CONTENT_ROOT` value, via
     `gen_settings_hooks.ensure_positive_marker`. `settings.json` itself is
     untracked/gitignored on this fleet's dev topology, so this value can
     only ever reflect what THIS machine generated for itself — never
     something a sync just delivered. Reuses the SAME migration
     discriminator `gen_settings_hooks.generate()` itself uses, so the two
     never drift on what "already consenting" means.
  2. VALIDATE hook-path shape in the CURRENT worktree `settings.json`
     against THIS machine, via `coordinator_core.ops.session.
     guard_foreign_platform_paths.detect_foreign_platform_paths` (read-only
     reuse of the existing shape-detector, not a re-derivation of it).
  3. RE-ARM the NEGATIVE kill switch
     (`gen_settings_hooks.kill_switch_marker_path`) if step 2 found a
     mismatch — a `settings.json` shaped for the OTHER platform just arrived
     on this machine (exactly the incident shape), so generation must stop
     until a human sorts it out, rather than the next `/coordinator:setup`
     run silently regenerating over the foreign content.

DETECT-AND-REPAIR, unlike the pre-commit sibling (which is DETECT-ONLY
because `settings.json` there is about to be PUSHED to a peer, and a
same-host "fix" would clobber that peer's next pull). Here the direction is
reversed: this machine just RECEIVED whatever landed, so re-arming its own
LOCAL kill switch cannot clobber anyone else — it only ever protects this
machine's own hook generation from running against config it doesn't trust.

Never blocks the git operation: post-merge/post-checkout hooks cannot undo a
merge/checkout by returning non-zero, so this script ALWAYS exits 0 — a
mismatch is reported loudly on stderr and repaired (kill switch armed), not
escalated as a hard failure. Every internal step is best-effort / fail-open;
an unimportable engine, an unreadable settings.json, or any unexpected
exception degrades to silent no-op, never a stack trace against the
operator's `git merge`.

Scope: only fires inside the meta-repo (git root == CLAUDE_HOME/.claude),
same discriminator as every sibling gate.

Exit contract: always 0. (There is no "block" outcome for this gate — see
above.)

Spec backlink: coordinator_core.install.gen_settings_hooks (kill-switch /
    positive-marker polarity inversion, same 2026-07-28 dispatch).
Sibling: coordinator-precommit-foreign-platform-check (pre-commit, detect-only,
    sending side), coordinator_core.ops.session.
    guard_hook_generation_self_probe (SessionStart, boot-triggered leg of the
    same defense — both re-arm the SAME negative marker via the SAME
    `gen_settings_hooks.kill_switch_marker_path` helper).

Invocation (2026-07-28): carries no shebang and no exec bit, matching its
pre-commit siblings. It is invoked ONLY via an explicit interpreter
(`coordinator_core.ops.install_meta_repo_precommit_hook`'s generated hook
body runs `"$_py" "$_gate_script"`, never bare-name/shebang-exec) —
POSIX-only execution assumptions are a portability defect class per the
2026-07-28 PM ruling (Windows is the P0 primary platform), enforced by
`coordinator_core.ops.check_posix_exec_assumptions`.
"""
from __future__ import annotations

import os
import subprocess
import sys

_BIN_DIR = os.path.dirname(os.path.abspath(__file__))
_LIB_DIR = os.path.join(_BIN_DIR, "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)


def _git_out(args: list, cwd: str = None) -> str:
    try:
        out = subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            timeout=30,
            cwd=cwd,
        )
    except Exception:
        return ""
    if out.returncode != 0:
        return ""
    return out.stdout or ""


def _resolve_meta_repo() -> str:
    """Meta-repo root via the canonical CLAUDE_HOME-aware claude-home resolver
    — same seam as the sibling precommit gates."""
    claude_home_lib = os.path.join(_BIN_DIR, "..", "lib", "claude-home")
    try:
        if claude_home_lib not in sys.path:
            sys.path.insert(0, os.path.abspath(claude_home_lib))
        import _claude_home  # noqa: E402

        return str(_claude_home.claude_home_dir())
    except Exception:
        base = os.environ.get("CLAUDE_HOME") or os.path.expanduser("~")
        return os.path.join(base, ".claude")


def _canon(path: str) -> str:
    try:
        return os.path.realpath(path)
    except OSError:
        return path


def _resolve_claude_klabauter_root() -> str:
    """This script already runs FROM inside claude-klabauter's own
    coordinator/bin/, so `coordinator_core` is importable via a
    parents-walk sys.path insert — no cross-repo resolution needed."""
    return os.path.abspath(os.path.join(_BIN_DIR, "..", ".."))


def _import_engine():
    """Best-effort import of the three engine seams this gate reuses.
    Returns a 3-tuple of callables, or None on any import failure (fail-open
    — see module docstring)."""
    claude_klabauter_root = _resolve_claude_klabauter_root()
    if claude_klabauter_root not in sys.path:
        sys.path.insert(0, claude_klabauter_root)
    try:
        from coordinator_core.install.gen_settings_hooks import (
            ensure_positive_marker,
            kill_switch_marker_path,
            resolve_settings_out_path,
        )
        from coordinator_core.ops.session.guard_foreign_platform_paths import (
            detect_foreign_platform_paths,
            format_banner,
        )
    except Exception as exc:  # noqa: BLE001 — fail-open, never blocks git
        print(
            f"post-merge: marker-resync check skipped (engine unimportable: {exc}).",
            file=sys.stderr,
        )
        return None
    return (
        ensure_positive_marker,
        kill_switch_marker_path,
        resolve_settings_out_path,
        detect_foreign_platform_paths,
        format_banner,
    )


def main() -> int:
    try:
        repo_root = _git_out(["rev-parse", "--show-toplevel"]).strip()
        if not repo_root:
            return 0

        meta_repo = _resolve_meta_repo()
        if not meta_repo:
            return 0

        if _canon(repo_root) != _canon(meta_repo):
            return 0

        engine = _import_engine()
        if engine is None:
            return 0
        (
            ensure_positive_marker,
            kill_switch_marker_path,
            resolve_settings_out_path,
            detect_foreign_platform_paths,
            format_banner,
        ) = engine

        settings_path = os.path.join(meta_repo, "settings.json")
        settings_out = resolve_settings_out_path(settings_path)

        # Step 1 — recreate a missing positive marker from its gitignored
        # per-machine source (this machine's own settings.json env block).
        try:
            marker, is_enabled, migrated = ensure_positive_marker(settings_out)
            if migrated:
                print(
                    f"post-merge: recreated positive marker {marker} from local "
                    "generation evidence.",
                    file=sys.stderr,
                )
        except Exception as exc:  # noqa: BLE001
            print(f"post-merge: positive-marker resync skipped (unexpected error: {exc}).", file=sys.stderr)

        # Step 2 — validate hook-path shape in the CURRENT worktree
        # settings.json against this machine.
        if not os.path.isfile(settings_path):
            return 0
        try:
            import json

            with open(settings_path, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            return 0

        doe_root_file = os.path.join(meta_repo, ".doe-root")
        local_root = None
        if os.path.isfile(doe_root_file):
            try:
                with open(doe_root_file, "r", encoding="utf-8", newline="") as fh:
                    local_root = fh.readline().rstrip("\r\n") or None
            except OSError:
                local_root = None

        findings = detect_foreign_platform_paths(data, local_coordinator_root=local_root)
        if not findings:
            return 0

        # Step 3 — mismatch found: re-arm the negative kill switch. This
        # machine just RECEIVED a foreign-shaped settings.json (the incident
        # transmission vector) — stop generation until a human sorts it out.
        banner = format_banner(findings, settings_path)
        print(banner, file=sys.stderr)
        marker_path = kill_switch_marker_path(settings_out)
        if not marker_path.is_file():
            try:
                marker_path.parent.mkdir(parents=True, exist_ok=True)
                marker_path.write_text(
                    "# re-armed by coordinator-postsync-marker-resync-check — "
                    "a foreign-platform-shaped settings.json arrived via git sync.\n",
                    encoding="utf-8",
                )
                print(
                    f"post-merge: RE-ARMED kill switch ({marker_path}) — "
                    "hook generation disabled until this is resolved.",
                    file=sys.stderr,
                )
            except OSError as exc:
                print(f"post-merge: could not write kill-switch marker {marker_path}: {exc}", file=sys.stderr)
        return 0
    except Exception as exc:  # noqa: BLE001 — never blocks/undoes the git operation
        print(f"post-merge: marker-resync check failed unexpectedly (ignored): {exc}", file=sys.stderr)
        return 0


if __name__ == "__main__":
    sys.exit(main())
