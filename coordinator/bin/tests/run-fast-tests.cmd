@echo off
setlocal enabledelayedexpansion
REM Windows launcher for run-fast-tests.py — python-direct (NO bash re-exec).
REM Generated by coordinator/bin/gen-launcher-shim.py — do NOT hand-edit; regenerate.
REM 2026-07-19 Windows de-bash campaign. See docs/wiki/windows-cmd-shims.md and
REM docs/plans/2026-07-19-debash-coordinator-windows.md.
REM
REM Resolves a Python interpreter and runs the co-located entrypoint "run-fast-tests.py"
REM directly. install-substrate.sh substitutes __PYTHON_BIN__ with the
REM absolute interpreter path resolved at install time (fast path: skips the
REM `py -3` double-indirection + the Microsoft Store App Execution Alias
REM picker), or with the empty string when no interpreter was resolvable.
REM Falls back to `where python.exe`, then `py -3`.
set "_py=__PYTHON_BIN__"
if "!_py!"=="__PYTHON_BIN__" set "_py="
if not "!_py!"=="" (
    "!_py!" "%~dp0run-fast-tests.py" %*
    exit /b !ERRORLEVEL!
)
for /f "delims=" %%i in ('where python.exe 2^>nul') do (
    echo %%i| findstr /I /C:"\WindowsApps\" >nul
    if errorlevel 1 (
        "%%i" "%~dp0run-fast-tests.py" %*
        exit /b !ERRORLEVEL!
    )
)
where py >nul 2>&1
if not errorlevel 1 (
    py -3 "%~dp0run-fast-tests.py" %*
    exit /b !ERRORLEVEL!
)
echo [run-fast-tests] ERROR: no Python interpreter found (python.exe / py -3). 1>&2
echo [run-fast-tests] Install Python: https://www.python.org/downloads/windows/ 1>&2
exit /b 127
