{
  "description": "Test fixture hooks.json for gen-settings-hooks tests",
  "hooks": {
    "SessionStart": [
      {
        "_comment": "Group with a CPR command, an mcp_tool, AND a non-CPR command (platform-localize style)",
        "matcher": "startup|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-guard.sh",
            "timeout": 5,
            "async": false
          },
          {
            "type": "mcp_tool",
            "server": "example-mcp-server",
            "tool": "session_heartbeat",
            "input": { "session_id": "${session_id}" },
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash ~/.claude/bin/platform-localize.sh",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bootstrap-substrate.py",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_comment": "Bash group: only mcp_tool entries — entire group should be SKIPPED",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "example-mcp-server",
            "tool": "nudge_foreground_agent_dispatch",
            "input": { "tool_name": "${tool_name}" },
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block-some-write.sh",
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "example-mcp-server",
            "tool": "nudge_improvement_queue_write",
            "input": { "tool_name": "${tool_name}" },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_comment": "ExitPlanMode: CPR command hook",
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/plan-persistence-check.py",
            "timeout": 15
          }
        ]
      },
      {
        "_comment": "All-mcp_tool group — should be SKIPPED",
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "example-mcp-server",
            "tool": "postuse_advisory_dispatch",
            "input": { "tool_name": "${tool_name}", "session_id": "${session_id}" },
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "_comment": "All non-CPR type:command — no ${CLAUDE_PLUGIN_ROOT} — entire group should be SKIPPED (empty-after-filter path)",
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/bin/subagent-cleanup.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "_comment": "Shape-P1 python3 CPR command (${CLAUDE_PLUGIN_ROOT}-anchored path) — must be emitted like the bash CPR entries",
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/py-example-hook.py",
            "timeout": 5
          }
        ]
      },
      {
        "_comment": "Shape-P2 module-form 'python3 -m ...' command — no ${CLAUDE_PLUGIN_ROOT} substring, so is_cpr_command is false; must be silently REJECTED (not emitted) rather than mistaken for a bakeable CPR hook. Regression net for the Shape-P2 hazard in 09-wiring-idempotency-edits.md §2 — this group should be entirely absent from generator output (empty-after-filter path).",
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m coordinator_core.hooks.x",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
