"""
coordinator-precommit-foreign-platform-check — pre-commit gate for the
~/.claude meta-repo: refuse a commit whose STAGED `settings.json` carries a
foreign-platform-shaped path (a Windows drive-letter form on a POSIX host, or
a POSIX-rooted form on a Windows host), OR whose STAGED `CLAUDE.md` /
`CLAUDE.local.md` carries a foreign-platform-shaped path ASSERTION in prose.

Two distinct surfaces, two distinct failure modes, one gate: `settings.json`
is the MACHINE-EXECUTABLE surface (a foreign path there silently kills every
hook); `CLAUDE.md`/`CLAUDE.local.md` is the AGENT-READABLE surface loaded
into every session (a foreign path there is read and trusted by an agent,
which then reports a checked-out repo as unreachable — the 2026-07-30
incident this leg closes: a sibling-repo map asserted `X:\\claude-unreal-
Example-game-repo` on a macOS machine, and an agent believed it). The prose leg uses a
narrower, path-ASSERTION-shaped detector (`detect_foreign_platform_paths_in_
prose`, in the engine module below) rather than the JSON-tree scan's bare
shape regex — free-form doctrine prose legitimately illustrates the very path
shapes this guard exists to catch (see that function's own docstring for the
worked false-positive examples and the residual gap it names honestly).

This is the leg of the foreign-platform-path guard that fires via git itself,
not via any Claude Code hook — it is what would have stopped the 2026-07-28
incident's corrupting commit (`ed0b972`, "safety") from ever landing. It
therefore survives a session where every Claude Code hook is already dead
(the exact circularity the SessionStart leg,
`coordinator/hooks/scripts/guard-foreign-platform-paths.py`, names as its own
residual gap).

Scope: only fires inside the meta-repo (git root == CLAUDE_HOME/.claude), same
discriminator as the sibling `coordinator-precommit-exec-bit-check`. Elsewhere
it exits 0 immediately.

Checks the STAGED blob (`git show :settings.json`), not the worktree copy —
consistent with git's own pre-commit contract (what's about to be committed,
not whatever happens to be sitting in the worktree).

DETECT-ONLY, never auto-fixes: `settings.json` is shared with another machine
via bidirectional git sync (push/pull + periodic "safety-commit" snapshots),
and a same-host "repair" is exactly the kind of write that would clobber the
OTHER machine on its next pull. A human/PM call is required to pick the
canonical per-machine value.

Residual gap this leg cannot close (named, not silently assumed away): a
corruption that never passes through a LOCAL `git commit` on this machine —
e.g. a `git pull --ff-only` that fast-forwards in a foreign-shaped
settings.json from `origin` without creating a new local commit object — does
not invoke `pre-commit` at all. A `post-merge` leg would be needed to close
that specific vector; not built here (scope-bounded to the leg that matches
the actually-observed incident mechanism — see the engine module's own
docstring for the evidence).

Exit contract:
  0 — clean, or not the meta-repo, or neither `settings.json` nor
      `CLAUDE.md`/`CLAUDE.local.md` staged this commit, or override set.
  1 — a foreign-platform-shaped path was found in the staged settings.json,
      and/or a foreign-platform-shaped path assertion was found in staged
      CLAUDE.md/CLAUDE.local.md prose. Blocks the commit; loud stderr
      banner(s) + override hint. Both legs share the one override env var —
      it is a single detect-only gate, not two independently-overridable
      ones.

Spec backlink: docs/plans (coordinator-claude) state/subagent-share/
  32637f2b-204d-4937-89a7-c3518928e38d/coordinatorexecutor-7bb4cb37.md
  and 230990b7-b7f4-4dfd-a864-4347b81d3f9e/coordinatorexecutor-87eba508.md
  (CLAUDE.md/CLAUDE.local.md prose leg, 2026-07-30)
Sibling: coordinator-precommit-exec-bit-check (same meta-repo-scoping shape).

Invocation (2026-07-28): carries no shebang and no exec bit. It is invoked
ONLY via an explicit interpreter (`coordinator_core.ops.
install_meta_repo_precommit_hook`'s generated hook body runs
`"$_py" "$_gate_script"`, never bare-name/shebang-exec) — POSIX-only
execution assumptions are a portability defect class per the 2026-07-28 PM
ruling (Windows is the P0 primary platform), enforced by
`coordinator_core.ops.check_posix_exec_assumptions`.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys

_BIN_DIR = os.path.dirname(os.path.abspath(__file__))
_LIB_DIR = os.path.join(_BIN_DIR, "lib")
if _LIB_DIR not in sys.path:
    sys.path.insert(0, _LIB_DIR)

_OVERRIDE_ENV = "COORDINATOR_OVERRIDE_PRECOMMIT_PLATFORM_PATHS"


def _git_out(args: list, cwd: str = None) -> str:
    try:
        out = subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            timeout=30,
            cwd=cwd,
        )
    except Exception:
        return ""
    if out.returncode != 0:
        return ""
    return out.stdout or ""


def _resolve_meta_repo() -> str:
    """Meta-repo root via the canonical CLAUDE_HOME-aware claude-home resolver
    (same seam as coordinator-precommit-exec-bit-check)."""
    claude_home_lib = os.path.join(_BIN_DIR, "..", "lib", "claude-home")
    try:
        if claude_home_lib not in sys.path:
            sys.path.insert(0, os.path.abspath(claude_home_lib))
        import _claude_home  # noqa: E402

        return str(_claude_home.claude_home_dir())
    except Exception:
        base = os.environ.get("CLAUDE_HOME") or os.path.expanduser("~")
        return os.path.join(base, ".claude")


def _canon(path: str) -> str:
    try:
        return os.path.realpath(path)
    except OSError:
        return path


def _resolve_claude_klabauter_root() -> str:
    """This script already runs FROM inside claude-klabauter's own coordinator/bin/,
    so `coordinator_core` is importable via a parents-walk sys.path insert —
    no cross-repo resolution needed, unlike the coordinator-claude-side hook stub."""
    return os.path.abspath(os.path.join(_BIN_DIR, "..", ".."))


def main() -> int:
    repo_root = _git_out(["rev-parse", "--show-toplevel"]).strip()
    if not repo_root:
        return 0

    meta_repo = _resolve_meta_repo()
    if not meta_repo:
        return 0

    if _canon(repo_root) != _canon(meta_repo):
        return 0

    if os.environ.get(_OVERRIDE_ENV) == "1":
        print(
            f"pre-commit: foreign-platform-path check skipped ({_OVERRIDE_ENV}=1).",
            file=sys.stderr,
        )
        return 0

    staged_files = [
        ln
        for ln in _git_out(
            ["-C", meta_repo, "diff", "--cached", "--name-only", "--diff-filter=d"]
        ).splitlines()
        if ln
    ]
    prose_files = [f for f in ("CLAUDE.md", "CLAUDE.local.md") if f in staged_files]
    if "settings.json" not in staged_files and not prose_files:
        return 0

    claude_klabauter_root = _resolve_claude_klabauter_root()
    if claude_klabauter_root not in sys.path:
        sys.path.insert(0, claude_klabauter_root)

    exit_code = 0

    # --- settings.json leg (machine-executable surface) ----------------------
    if "settings.json" in staged_files:
        staged_blob = _git_out(["-C", meta_repo, "show", ":settings.json"])
        data = None
        if staged_blob:
            try:
                data = json.loads(staged_blob)
            except ValueError:
                # Not this gate's concern -- a malformed JSON commit is a
                # different failure mode (settings-integrity guard's
                # territory), not this guard's shape-detection job.
                data = None
        if data is not None:
            engine_ok = True
            try:
                from coordinator_core.ops.session.guard_foreign_platform_paths import (
                    detect_foreign_platform_paths,
                    format_banner,
                )
            except Exception as exc:
                print(
                    f"pre-commit: foreign-platform-path check skipped (engine unimportable: {exc}).",
                    file=sys.stderr,
                )
                engine_ok = False

            if engine_ok:
                doe_root_file = os.path.join(meta_repo, ".doe-root")
                local_root = None
                if os.path.isfile(doe_root_file):
                    try:
                        with open(doe_root_file, "r", encoding="utf-8", newline="") as fh:
                            local_root = fh.readline().rstrip("\r\n") or None
                    except OSError:
                        local_root = None

                findings = detect_foreign_platform_paths(data, local_coordinator_root=local_root)
                if findings:
                    banner = format_banner(findings, "settings.json (staged)")
                    print(banner, file=sys.stderr)
                    print(
                        "pre-commit: BLOCKED — commit would land a foreign-platform-shaped path in settings.json.",
                        file=sys.stderr,
                    )
                    exit_code = 1

    # --- CLAUDE.md / CLAUDE.local.md leg (agent-readable surface) ------------
    for fname in prose_files:
        staged_blob = _git_out(["-C", meta_repo, "show", f":{fname}"])
        if not staged_blob:
            continue
        try:
            from coordinator_core.ops.session.guard_foreign_platform_paths import (
                detect_foreign_platform_paths_in_prose,
                format_prose_banner,
            )
        except Exception as exc:
            print(
                f"pre-commit: foreign-platform-path prose check skipped for {fname} (engine unimportable: {exc}).",
                file=sys.stderr,
            )
            continue

        prose_findings = detect_foreign_platform_paths_in_prose(staged_blob)
        if not prose_findings:
            continue

        banner = format_prose_banner(prose_findings, f"{fname} (staged)")
        print(banner, file=sys.stderr)
        print(
            f"pre-commit: BLOCKED — commit would land a foreign-platform-shaped path assertion in {fname}.",
            file=sys.stderr,
        )
        exit_code = 1

    if exit_code:
        print(
            f"Override (PM-authorized only): {_OVERRIDE_ENV}=1 git commit ...",
            file=sys.stderr,
        )
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
