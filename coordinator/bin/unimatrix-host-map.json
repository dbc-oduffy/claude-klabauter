{
  "agy": {
    "commands_to_skills": true,
    "copy_dirs": [
      "bin",
      "hooks",
      "scripts"
    ],
    "hook_drop_fields": [
      "description"
    ],
    "hook_events": [
      "PostInvocation",
      "PostToolUse",
      "PreInvocation",
      "PreToolUse",
      "SessionStart",
      "Stop"
    ],
    "hooks_path": "hooks.json",
    "ignore_top_level": [
      ".git",
      ".github",
      "__pycache__",
      "ceremony_tests",
      "node_modules",
      "templates",
      "tests"
    ],
    "max_text_bytes": 24000,
    "plugin_root_token": "${PLUGIN_DIR}",
    "rules_path": "rules/coordinator-doctrine.md",
    "tiers": {
      "haiku": "flash_lite",
      "opus": "pro",
      "sonnet": "flash"
    },
    "token_suffixes": [
      ".json",
      ".md"
    ],
    "tools": {
      "Bash": "run_command",
      "Edit": "edit_file",
      "Write": "write_file"
    },
    "valid_tiers": [
      "flash",
      "flash_lite",
      "inherit",
      "pro"
    ]
  },
  "codex": {},
  "grok": {}
}
